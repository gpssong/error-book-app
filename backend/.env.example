# MongoDB 连接地址（本地开发）
MONGODB_URI=mongodb://localhost:27017/error_book
# 如果 MongoDB 不可用，将 USE_MEMORY_DB=true 使用内存存储
USE_MEMORY_DB=false

# AI 接口配置（可选，不配置则使用模拟数据）
AI_PROVIDER=openai
AI_API_KEY=sk-placeholder
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 生成同类题时的题目数量
SIMILAR_QUESTION_COUNT=3

# 服务端口
PORT=3001

# ── 认证配置 ──────────────────────────────────────
# JWT 签名密钥（生产环境必须改成强随机字符串）
JWT_SECRET=error-book-dev-secret-change-me
# Token 有效期（jsonwebtoken 格式，如 7d / 24h）
JWT_EXPIRES_IN=7d
